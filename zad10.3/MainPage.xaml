<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zad10._3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Slider x:Name="Slider" Maximum="255" Minimum="0"/>
            <Label x:Name="Label1" Text="{Binding Source={x:Reference Slider}, StringFormat='{0:F0}', Path=Value}" />
            <Button Text="Zmień tło" Clicked="Button_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
