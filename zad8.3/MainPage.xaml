<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zad8._3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry Keyboard="Numeric" x:Name="Szerok" Placeholder="Wpisz szerokość prostokąta"/>
            <Entry Keyboard="Numeric" x:Name="Wysok" Placeholder="Wpisz wysokość prostokąta"/>
            <Button Text="Oblicz" Clicked="Button_Clicked"/>
            <Button Text="Wyczyść" Clicked="Button_Clicked1"/>
            <Label x:Name="Label1"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
