<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zad2._3.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label FontSize="Large" Text="Kalkulator powitań"/>
            <Entry x:Name="Imie" Placeholder="Wpisz swoje Imię"/>
            <Entry x:Name="Miasto" Placeholder="Wpisz swoje Miasto"/>
            <Button Text="Pokaz" Clicked="Button_Clicked" BackgroundColor="Blue"/>
            <Label x:Name="PokazMiasto"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
