<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zad10._2.MainPage">

    <ScrollView>
        <VerticalStackLayout
    Padding="30,0"
    Spacing="25">
            <Label Text="{Binding Source={x:Reference Uzytkownik}, Path=Text}" />
            <Entry x:Name="Uzytkownik"  Placeholder="Wpisz tekst"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
